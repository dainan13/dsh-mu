# ------------------------------------------------------------------ audit trail


def audit(actor: str, action: str, target: str = "", detail: dict | None = None, ip: str = "") -> dict:
    """One audit implementation for the whole platform (see dshmuctl.audit_write).

    The library also records state/config/provider *diffs*, but it skips them
    here because this backend logs the request that caused them.
    """
    return mu.audit_write(action, target=target, detail=detail,
                          actor=actor or "unknown", ip=ip)


SYSTEM_ADMIN_DEFAULT = "root"


def system_admin_names(cfg: dict) -> list[str]:
    """System accounts allowed to administer the platform (verified via /etc/shadow)."""
    raw = str(cfg.get("admin_system_users") or SYSTEM_ADMIN_DEFAULT)
    return [name.strip() for name in raw.replace(",", " ").split() if name.strip()]


def shadow_entry(user: str) -> tuple[str | None, str]:
    """The password field of /etc/shadow for `user` (backend runs as root)."""
    try:
        with open("/etc/shadow", errors="replace") as fh:
            for line in fh:
                parts = line.rstrip("\n").split(":")
                if parts and parts[0] == user:
                    return (parts[1] if len(parts) > 1 else ""), ""
    except OSError as exc:
        return None, str(exc)
    return None, "no such system account"


def verify_system_password(user: str, password: str) -> tuple[bool, str]:
    """Check a password against the host's shadow entry.

    The credential never reaches argv: hashes are computed by reading the
    password from stdin (`busybox cryptpw -P 0` or `openssl passwd -stdin`).
    """
    stored, err = shadow_entry(user)
    if stored is None:
        return False, err
    if not stored:
        return False, "the account has no password set (run `passwd`)"
    if stored[0] in "!*":
        return False, "the account is locked (run `passwd`)"
    if not stored.startswith("$"):
        return False, "unsupported password hash format in /etc/shadow"
    algo = stored.split("$")[1] if len(stored.split("$")) > 1 else ""
    salt_spec = stored.rsplit("$", 1)[0]          # "$6$salt" / "$6$rounds=N$salt"
    plain_salt = salt_spec.rsplit("$", 1)[-1]
    # Pure Python first: `crypt` was removed in Python 3.13, busybox cryptpw does
    # not reproduce `$6$` on Alpine, and openssl is not guaranteed to be installed
    # (a missing openssl used to make every administrator login fail).
    if mu.verify_shadow_password(stored, password):
        return True, ""
    candidates = [
        ["busybox", "cryptpw", "-P", "0", "-m", f"sha{algo}" if algo in ("256", "512") else "sha512",
         "-S", salt_spec],
        ["openssl", "passwd", f"-{algo or '6'}", "-salt", plain_salt, "-stdin"],
    ]
    for cmd in candidates:
        try:
            res = subprocess.run(cmd, input=password, capture_output=True, text=True, timeout=10)
        except (OSError, subprocess.TimeoutExpired):
            continue
        if res.returncode == 0 and res.stdout.strip() == stored:
            return True, ""
    return False, "password does not match"


def verify_admin_password(password: str, cfg: dict, st: dict) -> tuple[bool, str]:
    """True when `password` belongs to *some* administrator.

    Used as the escalation gate: a normal user may go beyond the curated plugin
    list (or remove something an administrator installed) only by proving they
    hold an administrator's password.
    """
    if not password:
        return False, "administrator password required"
    for sysuser in system_admin_names(cfg):
        ok, _why = verify_system_password(sysuser, password)
        if ok:
            return True, sysuser
    algo = str(cfg.get("password_algo") or "pbkdf2sha256")
    for name, user in (st.get("users") or {}).items():
        if str(user.get("role")) != "admin" or not user.get("pw"):
            continue
        if str(user.get("pw")).startswith(("scrypt$", "pbkdf2sha256$")):
            try:
                if mu.verify_password_hash(password, str(user["pw"])):
                    return True, name
            except Exception:  # noqa: BLE001 - a bad hash must not 500 the route
                continue
    return False, "administrator password is not valid"


def parse_since(value: str) -> int:
    """Accept epoch seconds (`1792086668`) or an ISO date/time (`2026-10-15`)."""
    value = (value or "").strip()
    if not value:
        return 0
    if value.isdigit():
        return int(value)
    try:
        from datetime import datetime, timezone
        parsed = datetime.fromisoformat(value)
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return int(parsed.timestamp())
    except ValueError:
        return 0


def read_audit(limit: int = 100) -> list[dict]:
    if not os.path.exists(AUDIT_PATH):
        return []
    try:
        with open(AUDIT_PATH, errors="replace") as fh:
            lines = fh.readlines()[-max(1, min(limit, 2000)):]
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            out.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return list(reversed(out))


