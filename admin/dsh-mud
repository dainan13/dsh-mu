def with_state(fn):
    """Run `fn(state)` under the platform state lock and persist the result."""
    def wrapper(*args, **kwargs):
        with mu.state_lock():
            st = mu.load_state()
            result = fn(st, *args, **kwargs)
            mu.save_state(st)
        return result
    return wrapper


def ns(**kwargs):
    """Synthetic argparse namespace for the CLI functions we reuse."""
    return argparse.Namespace(**kwargs)


def do_user_create(st: dict, body: dict) -> tuple[int, dict]:
    name = str(body.get("name", "")).strip().lower()
    if not name:
        return 400, {"error": "name is required"}
    password = body.get("password") or mu.random_password()
    mu.cmd_user_add(ns(name=name, role=body.get("role", "user"), password=password,
                       instance=body.get("instance", "auto")))
    created = mu.load_state()["users"].get(name, {})
    return 201, {"user": {"name": name, "role": created.get("role"),
                          "instance": created.get("instance"),
                          "enabled": created.get("enabled")},
                 "generated_password": password if not body.get("password") else None}


def do_user_password(name: str, body: dict) -> tuple[int, dict]:
    password = body.get("password") or mu.random_password()
    mu.cmd_user_passwd(ns(name=name, password=password))
    return 200, {"user": name, "sessions_invalidated": True,
                 "generated_password": password if not body.get("password") else None}


def do_instance_create(st: dict, body: dict) -> tuple[int, dict]:
    name = str(body.get("name", "")).strip()
    if not name:
        return 400, {"error": "name is required"}
    mu.cmd_instance_create(ns(name=name, user=body.get("user") or name,
                              cpu=body.get("cpu_max"), mem=body.get("mem_max"),
                              pids=body.get("pids_max"), port=body.get("port"),
                              cpu_cores=body.get("cpu_cores"), mem_mb=body.get("mem_mb"),
                              pids_num=body.get("pids_num"),
                              start=bool(body.get("start"))))
    return 201, {"instance": instance_view(mu.load_state(), name)}


def do_instance_action(action: str, name: str, body: dict) -> tuple[int, dict]:
    if action == "logs":
        return 200, tail_log(f"{mu.LOGS}/{name}.log", int(body.get("lines", 200)))
    if action == "start":
        mu.cmd_instance_start(ns(names=[name], no_wait=True))
    elif action == "stop":
        mu.cmd_instance_stop(ns(names=[name]))
    elif action == "restart":
        mu.cmd_instance_restart(ns(names=[name], no_wait=True))
    elif action == "refresh-cookie":
        mu.cmd_instance_refresh_cookie(ns(names=[name]))
    elif action == "limits":
        mu.cmd_instance_limits(ns(name=name, cpu=body.get("cpu_max"),
                                  mem=body.get("mem_max"), pids=body.get("pids_max")))
    return 200, {"instance": instance_view(mu.load_state(), name)}


