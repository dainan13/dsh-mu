def mu_exc_message(exc: BaseException) -> str:
    """The message a `dshmuctl.die()` carried, falling back to str(exc)."""
    return str(getattr(exc, "message", "") or exc)


def instance_view(st: dict, name: str) -> dict:
    inst = st["instances"][name]
    port = int(inst.get("port", 0))
    provider = inst.get("provider") or {}
    # The provider table on the page shows a credential column: it used to read
    # `key_set`/`key_source`, which this view never returned - so the column always
    # said "not set", even right after a key had been stored.
    try:
        _key, key_source = mu.provider_credentials(st, name)
    except Exception:  # noqa: BLE001 - a broken store must not break the list
        _key, key_source = None, "none"
    try:
        resources = mu.instance_resources(name)
    except Exception:  # noqa: BLE001 - metrics must never break the instance list
        resources = {}
    return {
        "name": name,
        "resources": resources,
        "user": inst.get("user", ""),
        "port": port,
        "state": inst.get("state", "?"),
        "live": mu.port_in_use(port),
        "cookie": bool(inst.get("upstream", {}).get("cookie")),
        "uid": int(inst.get("uid", 0)),
        "limits": {k: inst.get(k) for k in ("cpu_max", "mem_max", "mem_high", "pids_max")},
        "limits_human": mu.human_limits(inst),
        "provider": provider.get("preset", "deepseek"),
        "provider_model": provider.get("model", ""),
        "key_set": bool(_key),
        "key_source": key_source,
        "service_installed": os.path.exists(f"/etc/init.d/dsh-mu-{name}"),
        "boot_start": os.path.exists(f"/etc/runlevels/default/dsh-mu-{name}"),
        "disk_mb": mu._du_mb(f"{mu.INSTANCES_DIR}/{name}"),
        "log_bytes": (os.path.getsize(f"{mu.LOGS}/{name}.log")
                      if os.path.exists(f"{mu.LOGS}/{name}.log") else 0),
        "restarts": int(inst.get("restarts", 0)),
        "port_range": [int(x) for x in (st["config"].get("port_range") or [])],
    }


def instances_view(st: dict) -> list[dict]:
    return [instance_view(st, name) for name in sorted(st["instances"])]


def overview(st: dict, cfg: dict) -> dict:
    instances = instances_view(st)
    checks = mu.doctor_checks(st)
    summary: dict[str, int] = {}
    for check in checks:
        summary[check["status"]] = summary.get(check["status"], 0) + 1
    files = mu.platform_log_files()
    return {
        "version": VERSION,
        "uptime_s": int(time.time() - STARTED),
        "platform": {
            "gateway_host": cfg.get("gateway_host"),
            "gateway_listen": cfg.get("gateway_listen"),
            "config_file": mu.CONF_PATH,
            "state_schema": st.get("schema"),
            "alpine": mu.host_alpine_version(),
            "dsh_version": mu.installed_dsh_version(),
            "port_range": cfg.get("port_range"),
        },
        "counts": {
            "users": len(st["users"]),
            "instances": len(instances),
            "running": sum(1 for i in instances if i["live"]),
            "admins": sum(1 for u in st["users"].values() if u.get("role") == "admin"),
        },
        "disk": {
            "free_mb": mu._disk_free_mb(mu.VAR if os.path.isdir(mu.VAR) else "/"),
            "template_mb": mu._du_mb(mu.TEMPLATE),
            "logs_mb": sum(os.path.getsize(p) for p in files if os.path.exists(p)) // (1024 * 1024),
        },
        "doctor": {"summary": summary,
                   "failing": [c["check"] for c in checks if c["status"] == mu.DOCTOR_FAIL],
                   "warning": [c["check"] for c in checks if c["status"] == mu.DOCTOR_WARN]},
        "instances": instances,
    }


def tail_log(path: str, lines: int) -> dict:
    """Tail a log, and explain emptiness instead of just returning [].

    logrotate runs with copytruncate (the service holds the descriptor), so the live
    file legitimately becomes 0 bytes at rotation time. Silently showing "(空)" made
    that look like the viewer was broken, so: fall back to the rotated copy and say
    which file the lines came from.
    """
    want = max(1, min(lines, 2000))
    if not os.path.exists(path):
        return {"file": path, "lines": [], "error": "no such log", "source": "missing"}

    def read_tail(target: str) -> list[str]:
        with open(target, errors="replace") as fh:
            return [line.rstrip("\n") for line in fh.readlines()[-want:]]

    try:
        live = read_tail(path)
        size = os.path.getsize(path)
        mtime = int(os.path.getmtime(path))
    except OSError as exc:
        return {"file": path, "lines": [], "error": str(exc), "source": "error"}

    if live:
        return {"file": path, "lines": live, "source": "live", "size": size, "mtime": mtime}

    for suffix in ("1", "2", "gz"):
        rotated = f"{path}.{suffix}"
        if not os.path.exists(rotated):
            continue
        if suffix == "gz":
            try:
                import gzip
                with gzip.open(rotated, "rt", errors="replace") as fh:
                    rows = [line.rstrip("\n") for line in fh.readlines()[-want:]]
            except OSError:
                continue
            return {"file": rotated, "lines": rows, "source": "rotated",
                    "size": os.path.getsize(rotated), "mtime": int(os.path.getmtime(rotated)),
                    "note": "live log is empty (rotated); showing the rotated copy"}
        try:
            rows = read_tail(rotated)
        except OSError:
            continue
        if rows:
            return {"file": rotated, "lines": rows, "source": "rotated",
                    "size": os.path.getsize(rotated), "mtime": int(os.path.getmtime(rotated)),
                    "note": "live log is empty (rotated); showing the rotated copy"}

    return {"file": path, "lines": [], "source": "empty", "size": size, "mtime": mtime,
            "note": "no output yet since the log was rotated/truncated"}


